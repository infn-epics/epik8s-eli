        </color>
      </selected_color>
      <font>
        <font family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <rules>
        <rule name="New Rule" prop_id="name" out_exp="false">
          <exp bool_exp="If pv0 == 0">
            <value>set Color to Blue</value>
          </exp>
          <exp bool_exp="If pv0 == 1">
            <value>set Color to Blue</value>
          </exp>
          <pv_name>loc://selectedTab(0)</pv_name>
        </rule>
        <rule name="Dynamic Background" prop_id="active_tab" out_exp="false">
          <exp bool_exp="pv0 == 0">
            <value>#0078D7</value>
          </exp>
          <exp bool_exp="pv0 == 1">
            <value>#E81123</value>
          </exp>
          <exp bool_exp="pv0 == 2">
            <value>#107C10</value>
          </exp>
          <pv_name>loc://active_tab</pv_name>
        </rule>
      </rules>
      <scripts>
        <script file="EmbeddedJs">
          <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

# Get the index of the tab clicked (0 through 12)
idx = widget.getPropertyValue("selection")

# 1. Update the Local PV for the background color rule
PVUtil.writePV("loc://tab_state", idx)

# 2. Update the Container's Macros
# Assuming your container is named "ContentContainer" 
# and your macro for the file is $(tab_file)
container = display.getWidget("ContentContainer")
new_macro = "tab_" + str(idx) + ".bob" 

container.setPropertyValue("macros", {"tab_file": new_macro})]]></text>
          <pv_name>tab_index</pv_name>
        </script>
      </scripts>
    </widget>
