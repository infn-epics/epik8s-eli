<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>SCN Flag</name>
  <width>160</width>
  <height>130</height>
  <background_color><color red="240" green="240" blue="240"></color></background_color>
  <widget type="label" version="2.0.0">
    <name>SCN heading</name>
    <text>$(SCN=SCN?)</text>
    <x>6</x><y>3</y><width>148</width><height>24</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <font><font family="Liberation Sans" style="BOLD" size="18.0"></font></font>
    <foreground_color><color red="23" green="78" blue="232"></color></foreground_color>
    <background_color><color red="255" green="255" blue="255" alpha="0"></color></background_color>
    <tooltip>$(P):$(R)</tooltip>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Flag subtitle</name>
    <text>Flag</text>
    <x>6</x><y>27</y><width>148</width><height>16</height>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <font><font family="Liberation Sans" style="BOLD" size="11.0"></font></font>
    <foreground_color><color red="89" green="103" blue="119"></color></foreground_color>
    <background_color><color red="255" green="255" blue="255" alpha="0"></color></background_color>
    <tooltip>$(P):$(R)</tooltip>
  </widget>
  <widget type="led" version="2.0.0">
      <name>Aperto</name>
      <height>14</height>
      <width>14</width>
      <pv_name>$(P):$(R):MSTA.BD</pv_name>
      <x>61</x>
      <y>49</y>
    </widget>
  <widget type="led" version="2.0.0">
      <name>Chiuso</name>
      <height>14</height>
      <width>14</width>
      <pv_name>$(P):$(R):MSTA.B2</pv_name>
      <x>61</x>
      <y>68</y>
    </widget>
  <widget type="led" version="2.0.0">
      <name>Moving</name>
      <height>14</height>
      <width>14</width>
      <pv_name>$(P):$(R):MSTA.BA</pv_name>
      <x>85</x>
      <y>49</y>
    </widget>
  <widget type="led" version="2.0.0">
      <name>Error</name>
      <height>14</height>
      <width>14</width>
      <pv_name>$(P):$(R):MSTA.B9</pv_name>
      <x>85</x>
      <y>68</y>
      <on_color>
        <color name="MAJOR" red="255" green="0" blue="0">
        </color>
      </on_color>
    </widget>
  <widget type="label" version="2.0.0">
      <name>Label_1</name>
      <vertical_alignment>1</vertical_alignment>
      <horizontal_alignment>1</horizontal_alignment>
      <height>18</height>
      <text>OPENED</text>
      <x>4</x>
      <y>47</y>
      <width>51</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </font>
    </widget>
  <widget type="label" version="2.0.0">
      <name>Label_2</name>
      <vertical_alignment>1</vertical_alignment>
      <horizontal_alignment>1</horizontal_alignment>
      <height>18</height>
      <text>CLOSED</text>
      <x>4</x>
      <y>66</y>
      <width>51</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </font>
    </widget>
  <widget type="label" version="2.0.0">
      <name>Label_3</name>
      <vertical_alignment>1</vertical_alignment>
      <horizontal_alignment>1</horizontal_alignment>
      <height>18</height>
      <text>Moving</text>
      <x>105</x>
      <y>47</y>
      <width>51</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </font>
    </widget>
  <widget type="label" version="2.0.0">
      <name>Label_4</name>
      <vertical_alignment>1</vertical_alignment>
      <horizontal_alignment>1</horizontal_alignment>
      <height>18</height>
      <text>Error</text>
      <x>105</x>
      <y>66</y>
      <width>51</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="11.0">
        </font>
      </font>
    </widget>
  <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <height>26</height>
      <x>8</x>
      <actions execute_as_one="true">
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P):$(R):ACT</pv_name>
          <value>3</value>
        </action>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>OPEN</text>
      <y>96</y>
      <width>44</width>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="10.0">
        </font>
      </font>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
print 'Hello'
# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))
pvs[1].write("3") ## jog reverse
pvs[2].write("1")]]></text>
          <pv_name>$(pv_name)</pv_name>
          <pv_name>$(P):$(R):ACT</pv_name>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
        </script>
      </scripts>
      <tooltip>$(actions)</tooltip>
    </widget>
  <widget type="action_button" version="3.0.0">
      <name>Action Button_4</name>
      <height>26</height>
      <actions execute_as_one="true">
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P):$(R):ACT</pv_name>
          <value>4</value>
        </action>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>CLOSE</text>
      <x>58</x>
      <y>96</y>
      <width>44</width>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="10.0">
        </font>
      </font>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
print 'Hello'
# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))
pvs[1].write("4") ## jog forward
pvs[2].write("1")]]></text>
          <pv_name>$(pv_name)</pv_name>
          <pv_name>$(P):$(R):ACT</pv_name>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
        </script>
      </scripts>
      <tooltip>$(actions)</tooltip>
    </widget>
  <widget type="action_button" version="3.0.0">
      <name>Action Button_5</name>
      <height>26</height>
      <actions>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
          <value>2</value>
        </action>
      </actions>
      <text>STOP</text>
      <x>108</x>
      <y>96</y>
      <width>44</width>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="10.0">
        </font>
      </font>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
print 'Hello'
# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))
pvs[2].write("2")]]></text>
          <pv_name>$(pv_name)</pv_name>
          <pv_name>$(P):$(R):ACT</pv_name>
          <pv_name>$(P):$(R):ACTX_SP</pv_name>
        </script>
      </scripts>
      <tooltip>$(actions)</tooltip>
    </widget>
</display>
