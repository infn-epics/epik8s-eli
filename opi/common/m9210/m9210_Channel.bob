  <widget type="textentry" version="3.0.0">
    <name>Text Input Template</name>
    <pv_name>$(DEVICE):AI$(CHAN):OFS_SP</pv_name>
    <x>102</x>
    <y>202</y>
    <width>88</width>
    <height>26</height>
    <font>
      <font name="IO Input 1" family="sans" style="BOLD" size="10.891089108910892">
      </font>
    </font>
    <foreground_color>
      <color name="IO PV OFF" red="77" green="77" blue="77">
      </color>
    </foreground_color>
    <background_color>
      <color name="IO InputPV Bg" red="255" green="255" blue="255">
      </color>
    </background_color>
    <precision>4</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <actions>
    </actions>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from java.lang import Thread, Runnable

if len(pvs) > 0 and pvs[0] is not None:
    trigger_pv_name = pvs[0].getName() 

    # Split name by colons
    pv_parts = trigger_pv_name.split(":")
    
    # If the 4th part is an Analog Input (like AI0, AI1), drop it to get the core card base
    if "AI" in pv_parts[3]:
        base_channel_prefix = ":".join(pv_parts[0:3]) # Yields "LEL:DIA:FCT01"
    else:
        base_channel_prefix = ":".join(pv_parts[0:4])
        
    dynamic_msgs_pv = base_channel_prefix + ":MSGS"

    class AsyncOffsetCycle(Runnable):
        def __init__(self, msgs_target):
            self.msgs_target = msgs_target
        def run(self):
            try:
                print("Attempting to write OFF to: " + self.msgs_target)
                PVUtil.writePV(self.msgs_target, "OFF", 5000) 
                Thread.sleep(400)
                print("Attempting to write ON to: " + self.msgs_target)
                PVUtil.writePV(self.msgs_target, "ON", 5000)
                print("Offset cycle completed successfully.")
            except Exception as e:
                print("Dynamic Offset Reset Error: " + str(e))

    print("Targeting PV: " + str(dynamic_msgs_pv))
    Thread(AsyncOffsetCycle(dynamic_msgs_pv)).start()
else:
    print("Script Error: No valid PVs attached.")
]]></text>
        <pv_name>$(DEVICE):AI$(CHAN):OFS_SP</pv_name>
      </script>
    </scripts>
    <border_width>2</border_width>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Input Template_1</name>
    <pv_name>$(DEVICE):AI$(CHAN):RNG_SP</pv_name>
    <x>102</x>
    <y>242</y>
    <width>88</width>
    <height>26</height>
    <font>
      <font name="IO Input 1" family="sans" style="BOLD" size="10.891089108910892">
      </font>
    </font>
    <foreground_color>
      <color name="IO PV OFF" red="77" green="77" blue="77">
      </color>
    </foreground_color>
    <background_color>
      <color name="IO InputPV Bg" red="255" green="255" blue="255">
      </color>
    </background_color>
    <precision>4</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <actions>
    </actions>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from java.lang import Thread, Runnable

# 1. Dynamically read the current widget's underlying PV name
trigger_pv_name = pvs[0].getName() # e.g., "LEL:DIA:FCT01:RNG_SP" or "LEL:DIA:FCT02:RNG_SP"


# 2. Reconstruct the target path for this specific device space
pv_parts = trigger_pv_name.split(":")
base_channel_prefix = ":".join(pv_parts[0:3]) 
dynamic_msgs_pv = base_channel_prefix + ":MSGS"

class AsyncRangeCycle(Runnable):
    def __init__(self, msgs_target):
        self.msgs_target = msgs_target
    def run(self):
        try:
            # Cycle only the local channel driver
            PVUtil.writePV(self.msgs_target, "OFF", 5000)
            Thread.sleep(400)
            PVUtil.writePV(self.msgs_target, "ON", 5000)
        except Exception as e:
            print("Dynamic Range Reset Error: " + str(e))

Thread(AsyncRangeCycle(dynamic_msgs_pv)).start()]]></text>
        <pv_name>$(DEVICE):AI$(CHAN):RNG_SP</pv_name>
      </script>
    </scripts>
    <border_width>2</border_width>
  </widget>
