        <pv_name trigger="false">$(DEVICE):AI$(CHAN):ATT_RB</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):TCNT</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):OFS_SP</pv_name>
      </script>
