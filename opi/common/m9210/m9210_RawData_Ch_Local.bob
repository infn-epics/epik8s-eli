  <widget type="label" version="2.0.0">
    <name>Integral_Display_Target</name>
    <text>Channel 0 Integral Result local PV:</text>
    <x>325</x>
    <y>10</y>
    <width>270</width>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from jarray import array
import math

try:
    # --- INDEX 0: Raw waveform signal data array ($(DEVICE):AI$(CHAN):AVG) ---
    pv_reading = pvs[0].read() 
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        
        if raw_data is not None and raw_data.size() > 750:
            total_samples = raw_data.size()
            
            cal_factor = 2.5  
            attenuation_factor = 1.0
            
            # --- INDEX 3: CLKF_SP (Sampling Rate Clock) ---
            clk_val = PVUtil.getDouble(pvs[3]) 
            if clk_val < 100.0:
                dt = 1.0 / (clk_val * 1e9)  
            else:
                dt = 1.0 / clk_val          
            
            # --- INDEX 1 & 2: Direct Draggable Absolute Local Markers ---
            try:
                m1_val = PVUtil.getDouble(pvs[1])
            except Exception:
                m1_val = 100.0  
                
            try:
                m2_val = PVUtil.getDouble(pvs[2])
            except Exception:
                m2_val = 400.0  

            # Safely clamp visual dragging bounds within array boundaries
            start_index = max(0, min(int(round(m1_val)), total_samples - 2))
            stop_index = max(0, min(int(round(m2_val)), total_samples - 1))
            
            # Ensure proper execution order if marker 2 is dragged left of marker 1
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
            
            # --- ADAPTIVE PRE-PULSE BASELINE (Samples 700 to 750) ---
            # This captures real-time hardware drift right before the pulse drops,
            # but won't change when you drag your markers around.
            baseline_start = 700
            baseline_end = 750
                
            baseline_sum = 0.0
            for i in range(baseline_start, baseline_end):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_end - baseline_start)
            
            # --- INDEX 8: READ OPI MANUAL HARDWARE TRIM KNOB ---
            manual_offset = 0.0
            if len(pvs) > 8:
                try:
                    manual_offset = PVUtil.getDouble(pvs[8]) # $(DEVICE):AI$(CHAN):OFS_SP
                except Exception:
                    manual_offset = 0.0
            
            # --- STRICT STABILIZED CUMULATIVE INTEGRAL LOOP ---
            charge_profile = [0.0] * total_samples
            running_area = 0.0
            final_frozen_charge = 0.0
            
            for idx in range(0, total_samples - 1):
                # 1. Before Marker 1: Lock flat at exactly zero
                if idx < start_index:
                    running_area = 0.0
                    charge_profile[idx] = 0.0
                    
                # 2. Inside Active Window: Accumulate pulse data
                elif idx >= start_index and idx < stop_index:
                    # Invert polarity (baseline - raw) to make the downward pulse integrate upward/positively
                    y1 = (baseline_avg + manual_offset) - raw_data.getDouble(idx)
                    y2 = (baseline_avg + manual_offset) - raw_data.getDouble(idx + 1)
                    running_area += (y1 + y2) / 2.0
                    
                    v_secs = running_area * dt
                    final_frozen_charge = (v_secs * 1e12 * attenuation_factor) / cal_factor
                    charge_profile[idx + 1] = final_frozen_charge
                    
                # 3. After Marker 2: Freeze execution completely to hold a stable plateau
                else:
                    charge_profile[idx + 1] = final_frozen_charge

            charge_profile[-1] = charge_profile[-2]
            
            # Update the numerical UI text label dynamically
            widget.setPropertyValue("text", "{:.2f} pC".format(final_frozen_charge))
            
            # --- INDEX 4: WRITE ARRAY TO LOCAL GRAPH PV ---
            if len(pvs) > 4:
                try:
                    java_array = array(charge_profile, 'd')
                    pvs[4].write(java_array)
                except Exception as plot_err:
                    print("Graph update deferred: " + str(plot_err))
                    
            # --- INDEX 5: WRITE FINAL CALCULATION OUT TO SCALAR NETWORK PV ---
#            if len(pvs) > 5:
#                try:
#                    pvs[5].write(float(final_frozen_charge))
#                except Exception as write_err:
#                    print("Scalar network write deferred: " + str(write_err))
            
except Exception as e:
    widget.setPropertyValue("text", "ERR")]]></text>
        <pv_name>$(DEVICE):AI$(CHAN):AVG</pv_name>
        <pv_name>$(DEVICE):AI$(CHAN):SET_START_IDX</pv_name>
        <pv_name>$(DEVICE):AI$(CHAN):SET_END_IDX</pv_name>
        <pv_name trigger="false">$(DEVICE):CLKF_SP</pv_name>
        <pv_name trigger="false">loc://fct01_integral_array[2048](0.0)</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):CHARGE_FINAL</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):ATT_RB</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):TCNT</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):OFS_SP</pv_name>
        <pv_name trigger="false">$(DEVICE):K_OFFSET</pv_name>
      </script>
    </scripts>
  </widget>
