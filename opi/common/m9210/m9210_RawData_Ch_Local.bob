  <widget type="xyplot" version="3.0.0">
    <name>X/Y Plot_1</name>
    <x>23</x>
    <y>486</y>
    <width>729</width>
    <height>389</height>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from jarray import array
 
try:
    # --- INDEX 0: Raw waveform signal data array ---
    pv_reading = pvs[0].read() 
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        
        if raw_data is not None and raw_data.size() > 40:
            total_samples = raw_data.size()
            
            cal_factor = 2.5  
            attenuation_factor = 1.0
            
            # --- INDEX 3: CLKF_SP (Sampling Rate Clock) ---
            clk_val = PVUtil.getDouble(pvs[3]) 
            if clk_val < 100.0:
                dt = 1.0 / (clk_val * 1e9)  
            else:
                dt = 1.0 / clk_val          
            
            # --- INDEX 1 & 2: Direct Absolute Local Markers ---
            m1_val = PVUtil.getDouble(pvs[1]) 
            m2_val = PVUtil.getDouble(pvs[2])   
            
            # Clamp boundaries cleanly inside the data array limits
            start_index = max(0, min(int(round(m1_val)), total_samples - 2))
            stop_index = max(0, min(int(round(m2_val)), total_samples - 1))
            
            # Ensure start_index is always before stop_index
            if start_index > stop_index:
                start_index, stop_index = stop_index, start_index
 
            # --- PURE PRE-TRIGGER BASELINE ---
            lookback_size = 40
            baseline_start = max(0, start_index - lookback_size - 15)
            baseline_end = max(0, start_index - 15)
            if (baseline_end - baseline_start) < 15:
                baseline_start = 0
                baseline_end = 40
                
            baseline_sum = 0.0
            for i in range(baseline_start, baseline_end):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(baseline_end - baseline_start)
            
            # --- FIXED WINDOW ACCUMULATED INTEGRAL ---
            charge_profile = [0.0] * total_samples
            running_area = 0.0
            final_frozen_charge = 0.0

            for idx in range(0, total_samples - 1):
                # 1. Before Marker 1: Lock flat at exactly zero
                if idx < start_index:
                    running_area = 0.0
                    charge_profile[idx] = 0.0
                    
                # 2. Between Marker 1 and Marker 2: Actively integrate the pulse
                elif idx >= start_index and idx < stop_index:
                    y1 = raw_data.getDouble(idx) - baseline_avg
                    y2 = raw_data.getDouble(idx + 1) - baseline_avg
                    running_area += (y1 + y2) / 2.0
                    
                    v_secs = running_area * dt
                    current_charge = (v_secs * 1e12 * attenuation_factor) / cal_factor
                    charge_profile[idx] = current_charge
                    final_frozen_charge = current_charge  
                    
                # 3. After Marker 2: Freeze math completely and hold a stable plateau
                else:
                    charge_profile[idx] = final_frozen_charge
 
            # Protect final array element boundary safely
            charge_profile[-1] = charge_profile[-2]
            
            # --- INDEX 4: WRITE TO THE CORRECT WAVEFORM PV (loc://fct01_integral_out) ---
            if len(pvs) > 4:
                try:
                    java_array = array(charge_profile, 'd')
                    pvs[4].write(java_array) 
                except Exception as plot_err:
                    print("Lower Graph data frame write deferred: " + str(plot_err))
                         
except Exception as e:
    print("Script Execution Error: " + str(e))]]></text>
        <pv_name>$(DEVICE):AI$(CHAN):AVG</pv_name>
        <pv_name trigger="false">$(DEVICE):AI$(CHAN):SET_START_IDX</pv_name>
