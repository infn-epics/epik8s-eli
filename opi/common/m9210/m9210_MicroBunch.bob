  <widget type="xyplot" version="3.0.0">
    <name>XY Graph Template</name>
    <x>5</x>
    <y>45</y>
    <width>696</width>
    <height>521</height>
    <foreground_color>
      <color name="IO Foreground" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <background_color>
      <color name="IO InputPV Bg" red="255" green="255" blue="255">
      </color>
    </background_color>
    <title>Microbunch Raw Data</title>
    <title_font>
      <font name="IO Title" family="sans" style="BOLD" size="13.861386138613861">
      </font>
    </title_font>
    <actions>
    </actions>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import ScriptUtil
from org.csstudio.display.builder.runtime.script import PVUtil
import math

# ==============================================================================
# --- LINAC HARDWARE CALIBRATION CONSTANTS ---
# ==============================================================================
ICT_SENSITIVITY = 5.0     # V*s/C (Standard Bergoz ICT constant)
ATTENUATION_FACTOR = 1.0  # Change to 10.0 if using a -20dB pad, or 100.0 if -40dB
ALPHA = 0.08              # Low-pass filter factor for the text display box

try:
    # 1. Read the live fast-burst array data from LEL:DIA:FCT01:MICB
    pv_reading = pvs[0].read()
    
    if pv_reading is not None:
        raw_data = pv_reading.getData()
        total_samples = raw_data.size()
        
        if total_samples > 0:
            
            # --- HARDWARE BURST MODE RESOLUTION TUNING ---
            # Optimizing baseline and time steps for the 64-sample cutoff
            if total_samples <= 64:
                dt = 1.0e-10          # 100 ps step size (Adjust to match your scope clock)
                baseline_window = 5   # Keep window small so it doesn't swallow the microbunches
            elif total_samples > 1500:
                dt = 2.5e-10          # 4 GS/s fallback
                baseline_window = 30
            else:
                dt = 5.0e-10          # 2 GS/s fallback
                baseline_window = 15
            
            # 2. Extract baseline noise level using the early safe samples
            baseline_sum = 0.0
            # Guardrail in case total_samples is incredibly small
            actual_window = min(baseline_window, total_samples)
            for i in range(actual_window):
                baseline_sum += raw_data.getDouble(i)
            baseline_avg = baseline_sum / float(actual_window)
            
            # Initialize the array container to map directly to your lower XY Plot
            running_profile = [0.0] * total_samples
            cumulative_area = 0.0
            
            # 3. HIGH-SPEED RUNNING TRAPEZOIDAL ENGINE
            # Looping through all 64 samples to reconstruct the fine noise details
            for j in range(0, total_samples - 1):
                # (raw - baseline) ensures the curve steps down cleanly into negative values
                y1 = raw_data.getDouble(j) - baseline_avg
                y2 = raw_data.getDouble(j + 1) - baseline_avg
                
                # Accumulate area step-by-step
                cumulative_area += (y1 + y2) / 2.0
                
                # Convert running integrated area into picocoulombs (pC)
                v_secs = cumulative_area * dt
                pC = (v_secs * ATTENUATION_FACTOR / ICT_SENSITIVITY) * 1e12
                
                # Assign to the corresponding profile index
                running_profile[j+1] = float(pC)
            
            # Handle boundary edge smoothing for index 0
            if total_samples > 1:
                running_profile[0] = running_profile[1]
            
            # 4. STREAM ARRAY DIRECTLY TO YOUR LOWER XY PLOT
            # Writes out to row #1: loc://microbunch_integral_array
            pvs[1].write(running_profile)
            
            # 5. UI TEXT LABEL DELIVERY (Optional Control Room Display Box)
            # Pulls the absolute final plateau charge value from the tail of the array
            final_charge = running_profile[-1]
            result_str = "{:.2f} pC".format(abs(final_charge))
            
            display_box = ScriptUtil.findWidgetByName(widget, "Integral_Display")
            if display_box is not None:
                display_box.setPropertyValue("text", result_str)
                
except Exception as e:
    print("Microbunch Core Array Engine Error: " + str(e))]]></text>
        <pv_name>LEL:DIA:FCT01:MICB</pv_name>
        <pv_name trigger="false">loc://microbunch_integral_array</pv_name>
      </script>
    </scripts>
