    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil
from java.lang import Thread, Runnable

# 1. Dynamically read the current widget's underlying PV name
trigger_pv_name = pvs[0].getName() # e.g., "LEL:DIA:FCT01:RNG_SP" or "LEL:DIA:FCT02:RNG_SP"


# 2. Reconstruct the target path for this specific device space
pv_parts = trigger_pv_name.split(":")
base_channel_prefix = ":".join(pv_parts[0:3]) 
dynamic_msgs_pv = base_channel_prefix + ":MSGS"

class AsyncRangeCycle(Runnable):
    def __init__(self, msgs_target):
        self.msgs_target = msgs_target
    def run(self):
        try:
            # Cycle only the local channel driver
            PVUtil.writePV(self.msgs_target, "OFF", 10) 
            Thread.sleep(400)
            PVUtil.writePV(self.msgs_target, "ON", 10)
        except Exception as e:
            print("Dynamic Range Reset Error: " + str(e))

Thread(AsyncRangeCycle(dynamic_msgs_pv)).start()]]></text>
        <pv_name>$(DEVICE):MICB_ID</pv_name>
      </script>
    </scripts>
    <border_width>2</border_width>
