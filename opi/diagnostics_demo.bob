              <action type="open_display">
                <description>Open Display</description>
                <file>common/m9210/m9210_Main.bob</file>
                <macros>
                  <DEVICE>LEL:DIA:FCT01</DEVICE>
                </macros>
                <target>window</target>
              </action>
            </actions>
            <text>ICT1</text>
            <x>38</x>
            <y>47</y>
            <width>120</width>
            <height>120</height>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="action_button" version="3.0.0">
            <name>Action Button_5</name>
            <actions>
              <action type="open_display">
                <description>Open Display</description>
                <file>common/m9210/m9210_Main.bob</file>
                <macros>
                  <DEVICE>LEL:DIA:FCT02</DEVICE>
                </macros>
                <target>window</target>
              </action>
            </actions>
            <text>ICT2</text>
            <x>618</x>
            <y>57</y>
            <width>120</width>
            <height>120</height>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="textupdate" version="2.0.0">
            <name>Text Update</name>
            <pv_name>LEL:DIA:FCT01:AI0:CHARGE_FINAL</pv_name>
            <x>138</x>
            <y>247</y>
          </widget>
          <widget type="textupdate" version="2.0.0">
            <name>Text Update_1</name>
            <pv_name>LEL:DIA:FCT02:AI0:CHARGE_FINAL</pv_name>
            <x>618</x>
            <y>247</y>
            <width>120</width>
          </widget>
          <widget type="stripchart" version="2.1.0">
            <name>Strip Chart</name>
            <x>38</x>
            <y>267</y>
            <width>700</width>
            <start>3 minute</start>
            <traces>
              <trace>
                <name>$(traces[0].y_pv)</name>
                <y_pv>LEL:DIA:FCT01:AI0:CHARGE_FINAL</y_pv>
                <axis>0</axis>
                <trace_type>2</trace_type>
                <color>
                  <color red="0" green="0" blue="255">
                  </color>
                </color>
                <line_width>2</line_width>
                <point_type>0</point_type>
                <point_size>10</point_size>
                <visible>true</visible>
              </trace>
              <trace>
                <name>$(traces[1].y_pv)</name>
                <y_pv>LEL:DIA:FCT02:AI0:CHARGE_FINAL</y_pv>
                <axis>0</axis>
                <trace_type>2</trace_type>
                <color>
                  <color red="255" green="0" blue="0">
                  </color>
                </color>
                <line_width>2</line_width>
                <point_type>0</point_type>
                <point_size>10</point_size>
                <visible>true</visible>
              </trace>
            </traces>
          </widget>
          <widget type="label" version="2.0.0">
            <name>Label</name>
            <text>Charge ICT1</text>
            <x>18</x>
            <y>245</y>
            <font>
              <font family="Liberation Sans" style="BOLD" size="16.0">
              </font>
            </font>
          </widget>
          <widget type="label" version="2.0.0">
