            </actions>
            <text>ORBIT Single</text>
            <x>49</x>
            <y>38</y>
            <width>180</width>
            <height>80</height>
            <tooltip>$(actions)</tooltip>
          </widget>
          <widget type="group" version="3.0.0">
            <name>Orbit Control</name>
            <x>39</x>
            <y>137</y>
            <width>200</width>
            <height>151</height>
            <widget type="combo" version="2.0.0">
              <name>Combo Box</name>
