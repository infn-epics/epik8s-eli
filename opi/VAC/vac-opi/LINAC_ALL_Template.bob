      </font>
      <format>2</format>
      <precision>2</precision>
      <show_units>false</show_units>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="New Rule1" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0 &lt; 1e-8">
            <value>
              <color name="OK" red="0" green="255" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0 &gt;= 1e-8 &amp;&amp; pv0 &lt;= 1e-7 ">
            <value>
              <color name="Attention" red="255" green="160" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="pv0 &gt; 1e-7">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(pv_name)</pv_name>
        </rule>
      </rules>
      <border_width>1</border_width>
    </widget>
