          </selected_color>
          <deselected_color>
            <color red="200" green="200" blue="200">
            </color>
          </deselected_color>
        </tab>
        <tab>
          <name>Laser</name>
          <file>timing/mrf230-opi/delay-app.bob</file>
          <macros>
            <R>EVR-LAS</R>
            <TITLE>Laser Delays</TITLE>
          </macros>
          <group_name></group_name>
          <selected_color>
            <color red="236" green="236" blue="236">
            </color>
          </selected_color>
          <deselected_color>
            <color red="200" green="200" blue="200">
            </color>
          </deselected_color>
        </tab>
        <tab>
          <name>LLRF</name>
          <file>timing/mrf230-opi/delay-app.bob</file>
          <macros>
            <R>EVR-LLRF</R>
            <TITLE>LLRF Timing Delays</TITLE>
          </macros>
          <group_name></group_name>
          <selected_color>
            <color red="236" green="236" blue="236">
            </color>
          </selected_color>
          <deselected_color>
            <color red="200" green="200" blue="200">
            </color>
          </deselected_color>
        </tab>
        <tab>
          <name>RF Driver</name>
          <file>timing/mrf230-opi/delay-app.bob</file>
          <macros>
            <R>EVR-RFD</R>
            <TITLE>RF Driver Delays</TITLE>
