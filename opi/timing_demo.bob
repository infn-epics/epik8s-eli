<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>timing_demo</name>
  <width>1800</width>
  <height>820</height>
  <widget type="group" version="3.0.0">
    <name>Timing Delay</name>
    <macros>
      <P>LEL:TIM</P>
    </macros>
    <width>1220</width>
    <height>350</height>
    <widget type="navtabs" version="2.0.0">
      <name>Timing Delay Nav</name>
      <tabs>
        <tab>
          <name>BPM &amp; CAMs</name>
          <file>timing/mrf230-opi/delay-app.bob</file>
          <macros>
            <R>EVR-BPMCAM</R>
            <TITLE>BPM &amp; CAM 0-1 Delays</TITLE>
          </macros>
          <group_name>Diag 1</group_name>
          <selected_color>
            <color red="236" green="236" blue="236">
            </color>
          </selected_color>
          <deselected_color>
            <color red="200" green="200" blue="200">
            </color>
          </deselected_color>
        </tab>
        <tab>
          <name>CAM</name>
          <file>timing/mrf230-opi/delay-app.bob</file>
          <macros>
            <R>EVR-CAM</R>
            <TITLE>Cam 2-6 Timing Delay</TITLE>
          </macros>
          <group_name></group_name>
          <selected_color>
            <color red="236" green="236" blue="236">
            </color>
          </selected_color>
          <deselected_color>
            <color red="200" green="200" blue="200">
            </color>
          </deselected_color>
        </tab>
        <tab>
          <name>ADC</name>
