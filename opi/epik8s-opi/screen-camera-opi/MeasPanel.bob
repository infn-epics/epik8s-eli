  <widget type="label" version="2.0.0">
    <name>CursorInfo</name>
    <x>188</x>
    <y>38</y>
    <width>140</width>
    <height>18</height>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <scripts>
      <script file="Scripts/GetPixelInfo.py">
        <pv_name>loc://cursor_info</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="image" version="2.0.0">
    <name>CameraImage</name>
    <pv_name>pva://$(DEVICE):$(CAM):PVA:OUTPUT</pv_name>
    <x>12</x>
    <y>58</y>
    <width>316</width>
    <height>260</height>
    <show_toolbar>true</show_toolbar>
    <cursor_info_pv>loc://cursor_info</cursor_info_pv>
    <x_pv>loc://cursor_x</x_pv>
    <y_pv>loc://cursor_y</y_pv>
    <rules>
      <rule name="interactive" prop_id="rois[0].interactive" out_exp="false">
        <exp bool_exp="pv0&lt;1">
          <value>false</value>
        </exp>
        <pv_name>loc://roi_interactive(1)</pv_name>
      </rule>
      <rule name="centroidHvisible" prop_id="rois[1].visible" out_exp="false">
        <exp bool_exp="pv0&lt;1">
          <value>false</value>
        </exp>
        <pv_name>$(DEVICE):$(CAM):Stats1:ComputeCentroid_RBV</pv_name>
      </rule>
      <rule name="centroidVvisible" prop_id="rois[2].visible" out_exp="false">
        <exp bool_exp="pv0&lt;1">
          <value>false</value>
        </exp>
        <pv_name>$(DEVICE):$(CAM):Stats1:ComputeCentroid_RBV</pv_name>
      </rule>
    </rules>
    <limits_from_pv>true</limits_from_pv>
    <unsigned>true</unsigned>
    <autoscale>true</autoscale>
    <rois>
      <roi>
        <name>imageROI</name>
        <color>
          <color red="255" green="168" blue="0">
          </color>
        </color>
        <visible>true</visible>
        <interactive>true</interactive>
        <x_pv>loc://roi_x(20)</x_pv>
        <y_pv>loc://roi_y(20)</y_pv>
        <width_pv>loc://roi_w(100)</width_pv>
        <height_pv>loc://roi_h(100)</height_pv>
        <file></file>
      </roi>
      <roi>
        <name>CentroidH</name>
        <color>
          <color red="0" green="255" blue="255">
          </color>
        </color>
        <visible>true</visible>
        <interactive>false</interactive>
        <x_pv>=0</x_pv>
        <y_pv>='$(DEVICE):$(CAM):Stats1:CentroidY_RBV'-1</y_pv>
        <width_pv>=100000</width_pv>
        <height_pv>=2</height_pv>
        <file></file>
      </roi>
      <roi>
        <name>CentroidV</name>
        <color>
          <color red="0" green="255" blue="255">
          </color>
        </color>
        <visible>true</visible>
        <interactive>false</interactive>
        <x_pv>='$(DEVICE):$(CAM):Stats1:CentroidX_RBV'-1</x_pv>
        <y_pv>=0</y_pv>
        <width_pv>=2</width_pv>
        <height_pv>=100000</height_pv>
        <file></file>
      </roi>
    </rois>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Section_ROI</name>
