          <widget type="group" version="3.0.0">
            <name>Commands</name>
            <x>8</x>
            <y>126</y>
            <width>880</width>
            <height>140</height>
            <style>3</style>
            <widget type="action_button" version="3.0.0">
              <name>cmd_rstfault</name>
              <actions>
                <action type="write_pv">
                  <description>Reset Faults</description>
                  <pv_name>$(P)$(M):CMD:RSTFAULT</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Reset Faults</text>
              <x>12</x>
              <y>30</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <confirm_message>Reset faults on $(P)$(M)?</confirm_message>
            </widget>
            <widget type="action_button" version="3.0.0">
              <name>cmd_save</name>
              <actions>
                <action type="write_pv">
                  <description>Save to EEPROM</description>
                  <pv_name>$(P)$(M):CMD:SAVE</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Save to EEPROM</text>
              <x>172</x>
              <y>30</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <confirm_message>Save current parameters to EEPROM on $(P)$(M)?
This writes flash memory.</confirm_message>
            </widget>
            <widget type="action_button" version="3.0.0">
              <name>cmd_reset</name>
              <actions>
                <action type="write_pv">
                  <description>Reset Drive</description>
                  <pv_name>$(P)$(M):CMD:RESET</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Reset Drive</text>
              <x>332</x>
              <y>30</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <confirm_message>Reset the drive on $(P)$(M)?
This will interrupt motion and re-initialize the axis.</confirm_message>
            </widget>
            <widget type="action_button" version="3.0.0">
              <name>cmd_fhome</name>
              <actions>
                <action type="write_pv">
                  <description>Force Home</description>
                  <pv_name>$(P)$(M):CMD:FHOME</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Force Home</text>
              <x>492</x>
              <y>30</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <confirm_message>Force-home $(P)$(M) (set position=0, mark homed) without moving?
Only use when physically at the home switch.</confirm_message>
            </widget>
            <widget type="action_button" version="3.0.0">
              <name>cmd_clrenc</name>
              <actions>
                <action type="write_pv">
                  <description>Clear encoder counter</description>
                  <pv_name>$(P)$(M):CMD:CLRENC</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Clear Encoder</text>
              <x>12</x>
              <y>66</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <show_confirm_dialog>true</show_confirm_dialog>
              <confirm_message>Resetting encoder counters! Write 'ok' to confirm</confirm_message>
              <password>ok</password>
            </widget>
            <widget type="action_button" version="3.0.0">
              <name>cmd_clrstep</name>
              <actions>
                <action type="write_pv">
                  <description>Clear step counter</description>
                  <pv_name>$(P)$(M):CMD:CLRSTEP</pv_name>
                  <value>1</value>
                </action>
              </actions>
              <text>Clear Step Counter</text>
              <x>172</x>
              <y>66</y>
              <width>150</width>
              <tooltip>$(actions)</tooltip>
              <show_confirm_dialog>true</show_confirm_dialog>
              <confirm_message>Destroying homing reference by resetting step counter! Write 'ok' to confirm</confirm_message>
              <password>ok</password>
            </widget>
          </widget>
        </children>
      </tab>
