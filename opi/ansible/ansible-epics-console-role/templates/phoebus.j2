#!/usr/bin/env bash

PHOEBUS_OPTS="{{ phoebus_options }}"
PHOEBUS_JAR={{ phoebus_home }}/product-{{phoebus_version}}/product-{{phoebus_version}}.jar

export JAVA_ARGS=""

# Add proxy settings if defined
{% if proxy_url and proxy_port %}
{% set clean_proxy_url = proxy_url | regex_replace('^https?://', '') %}
export JAVA_ARGS="$JAVA_ARGS -Dhttp.proxyHost={{ clean_proxy_url }} -Dhttp.proxyPort={{ proxy_port }}"
export JAVA_ARGS="$JAVA_ARGS -Dhttps.proxyHost={{ clean_proxy_url }} -Dhttps.proxyPort={{ proxy_port }} -Dhttp.nonProxyHosts=localhost|127.0.*|10.*|192.168.*|*.lnf.infn.it"
{% endif %}

{{java_bin}} $JAVA_ARGS $JAVA_OPTS -jar $PHOEBUS_JAR $PHOEBUS_OPTS $@
