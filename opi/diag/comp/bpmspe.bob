<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BPM Open Details Button</name>
  <width>64</width>
  <height>36</height>
  <background_color>
    <color red="255" green="255" blue="255" alpha="0" />
  </background_color>
  <actions>
    <action type="open_display">
      <description>Open  SPE</description>
      <file>../libera-bpm-opi/GUI/LiberaSinglePassE/opi/signal_processing.bob</file>
      <target>replace</target>
    </action>
  </actions>
  <widget type="action_button" version="3.0.0">
    <name>Open BPM display</name>
    <x>0</x>
    <y>0</y>
    <width>64</width>
    <height>36</height>
    <text>$(BPM)
Open ↗</text>
    <font>
      <font family="Liberation Sans" style="BOLD" size="11.0" />
    </font>
    <foreground_color>
      <color red="145" green="65" blue="0" />
    </foreground_color>
    <background_color>
      <color red="255" green="232" blue="204" />
    </background_color>
    <transparent>false</transparent>
    <tooltip>Open $(BPM) measurements - Libera SPE</tooltip>
    <actions>
      <action type="open_display">
        <description>Open Libera SPE</description>
        <file>../libera-bpm-opi/libera-spe/signal_processing.bob</file>
        <target>window</target>
      </action>
    </actions>
  </widget>
</display>
