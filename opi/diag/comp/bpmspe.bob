<?xml version='1.0' encoding='utf-8'?>
<display version="2.0.0">
  <name>BPM Label Hotspot</name>
  <width>58</width>
  <height>32</height>
  <background_color>
    <color red="255" green="255" blue="255" alpha="0" />
  </background_color>
  <actions>
    <action type="open_display">
      <description>Open  SPE</description>
      <file>../libera-bpm-opi/GUI/LiberaSinglePassE/opi/signal_processing.bob</file>
      <target>replace</target>
    </action>
  </actions>
  <widget type="action_button" version="3.0.0">
    <name>Open BPM display</name>
    <x>0</x>
    <y>0</y>
    <width>58</width>
    <height>32</height>
    <text />
    <transparent>true</transparent>
    <tooltip>Open $(BPM) - Libera SPE</tooltip>
    <actions>
      <action type="open_display">
        <description>Open Libera SPE</description>
        <file>../libera-bpm-opi/libera-spe/signal_processing.bob</file>
        <target>window</target>
      </action>
    </actions>
  </widget>
</display>