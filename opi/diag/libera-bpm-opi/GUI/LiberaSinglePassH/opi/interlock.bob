        <exp bool_exp="pv0&gt;=0.0 &amp;&amp; pv0&lt;1.0">
          <value>false</value>
        </exp>
        <exp bool_exp="true">
          <value>true</value>
        </exp>
        <pv_name>$(HOSTNAME):$(BPM):ilk:status:ref_lock_open</pv_name>
      </rule>
    </rules>
  </widget>
</display>
