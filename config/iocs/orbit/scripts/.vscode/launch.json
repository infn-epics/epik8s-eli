    "version": "0.2.0",
    "configurations": [
        
        
        {
           "name": "Python: EPICS COLLECTOR",
            "type": "python",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "py-ioc-collector.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args":["-c","example/test-bcm.json"],
            "justMyCode": true,
            "env": {
                "EPICS_CA_ADDR_LIST": "10.10.6.244",
                "EPICS_CA_AUTO_ADDR_LIST": "NO",
                "QSRV_DISABLE": "YES",
                "EPICS_PVA_SERVER_PORT": "0",
                "EPICS_PVA_AUTO_ADDR_LIST": "NO",
                "EPICS_PVAS_INTF_ADDR_LIST":""
            }
        }


    ]
}