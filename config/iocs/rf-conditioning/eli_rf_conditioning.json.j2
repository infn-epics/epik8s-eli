{
    "prefix_rf_conditioning":"{{iocprefix}}",
    "prefix_LLRF":"{{llrf_prefix}}",
    "pv_to_build":
    [
    {
        "pvname":"CONDITIONING_STATUS",
        "type":"boolOut",
        "init_value":"0"
    },
    {
        "pvname":"CONDITIONING_SETPOINT",
        "type":"aOut",
        "init_value":"0"
    },
    {
        "pvname": "PUMPS_STATUS",
        "type": "stringIn",
        "init_value": "NONE"
    },
    {
        "pvname":"CONDITIONING_TARGET",
        "type":"aOut",
        "init_value":"0"
    },
{
            "pvname": "PREFIX_PUMPS",
            "type": "WaveformOut",
            {%- set prefixes = [] %}
            {%- for p in pump %}
                {%- set _ = prefixes.append('"' + p.prefix + '"') %}
            {%- endfor %}
            "init_value": [{{ prefixes | join(', ') }}]
        },
{
        "pvname":"VACUUM_PUMPS",
        "type":"WaveformOut",
        {%- set names = [] %}
        {%- for p in pump %}
            {%- set _ = names.append('"' + p.name + '"') %}
        {%- endfor %}
        "init_value":[{{ names | join(', ') }}]
    },
    {
        "pvname":"SUFFIX_PUMPS",
        "type":"WaveformOut",
        {%- set suff = [] %}
        {%- for p in pump %}
            {%- set _ = suff.append('"' + p.suffix + '"') %}
        {%- endfor %}
        "init_value":[{{ suff | join(', ') }}]
    },
    {
        "pvname":"VACUUM_TSH",
        "type":"WaveformOut",
        {%- set tsh = [] %}
        {%- for p in pump %}
            {%- set _ = tsh.append((p.tsh) | float) %}
        {%- endfor %}
        "init_value":[{{ tsh | join(', ') }}]
    },
    {
        "pvname":"COUNTER_INTLK",
        "type":"aIn",
        "init_value":"0"
    },
    {
        "pvname":"COUNTER_INTLK_TSH",
        "type":"aOut",
        "init_value":"{{init_counter_intlk}}"
    },
    {
        "pvname":"LAST_INTLK_SOURCE",
        "type":"stringIn",
        "init_value":"NONE"
    },
    {
        "pvname":"LAST_INTLK_DATETIME",
        "type":"stringIn",
        "init_value":"0"
    },
    {
        "pvname":"INTLK_HYSTERESIS",
        "type":"aOut",
        "init_value":"{{init_intlk_hyst}}"
    },
    {
        "pvname":"POWER_RAISE_STATUS",
        "type":"boolOut",
        "init_value":"0"
    },
    {
        "pvname":"POWER_RAISE_WAIT",
        "type":"aOut",
        "init_value":"{{init_raise_wait}}"
    },
    {
        "pvname":"POWER_RAISE_STEP",
        "type":"aOut",
        "init_value":"{{init_raise_step}}"
    },
    {
        "pvname":"RAISE_COUNT",
        "type":"aOut",
        "init_value":"0"
    },
    {
        "pvname":"VAC_ID",
        "type":"aIn",
        "init_value":"0"
    },
    {
    "pvname": "WF_SOURCE_SUFFIX",
    "type": "WaveformOut",
    "init_value": [
        ":ad1:ch1:power_remote.POWER",
        ":ad1:ch2:power_remote.POWER",
        ":ad1:ch3:power_remote.POWER",
        ":ad1:ch4:power_remote.POWER",
        ":ad1:ch5:power_remote.POWER",
        ":ad1:ch6:power_remote.POWER"
    ]
    },
    {
    "pvname": "WF_SOURCE_REFRESH_RATE",
    "type": "WaveformOut",
    "init_value": [
        ":ad1:ch1:power_remote.SCAN",
        ":ad1:ch2:power_remote.SCAN",
        ":ad1:ch3:power_remote.SCAN",
        ":ad1:ch4:power_remote.SCAN",
        ":ad1:ch5:power_remote.SCAN",
        ":ad1:ch6:power_remote.SCAN"
    ]
    },
    {
    "pvname":"WF_SOURCE_SEL",
    "type":"aOut",
    "init_value":"{{init_source_sel}}"
    },
    {
      "pvname": "WF_MASK_PERCENT",
      "type": "aOut",
      "init_value": "{{init_mask_percent}}"
    },
    {
      "pvname": "WF_OFFSET_CURS_US",
      "type": "aOut",
      "init_value": "{{init_offset_curs_us}}"
    },
    {
      "pvname": "WF_DURATION_CURS_US",
      "type": "aOut",
      "init_value": "{{init_duration_curs_us}}"
    },
    {
      "pvname": "WF_PULSE_PREV",
      "type": "WaveformOut",
      "init_value": "[0.0]*1017"
    },
    {
      "pvname": "WF_PREV_VALID",
      "type": "boolIn",
      "init_value": "0"
    },
    {
      "pvname": "WF_INTERLOCK",
      "type": "boolIn",
      "init_value": "0"
    },
    {
      "pvname": "WF_PULSE_INTLK_ENABLE",
      "type": "boolOut",
      "init_value": "0"
    },
    {
      "pvname": "WF_MASK_LOW",
      "type": "WaveformOut",
      "init_value": "[0.0]*1017"
    },
    {
      "pvname": "WF_MASK_HIGH",
      "type": "WaveformOut",
      "init_value": "[0.0]*1017"
    },
    {
      "pvname": "WF_PULSE_POSTMORTEM",
      "type": "WaveformOut",
      "init_value": "[0.0]*1017"
    },
    {
      "pvname": "VAC_THRESHOLD_REENABLE",
      "type": "aOut",
      "init_value": 0.8
    }
    ]
}
